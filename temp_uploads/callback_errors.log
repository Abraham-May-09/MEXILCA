oducts\/2361:Manufacture of concrete products for construction purposes","amount":1,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":null,"description":"Unidad funcional: 1 kg de block terminado en planta."},{"is_reference":false,"flow":"Part\u00edculas sedimentables","category":"E:Water supply; sewerage, waste management and remediation activities\/39:Remediation activities and other waste management services\/3900:Remediation activities and other waste management services","amount":9.328e-5,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire."},{"is_reference":false,"flow":"SO2","category":"E:Water supply; sewerage, waste management and remediation activities\/39:Remediation activities and other waste management services\/3900:Remediation activities and other waste management services","amount":3.291e-5,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire."},{"is_reference":false,"flow":"CO","category":"E:Water supply; sewerage, waste management and remediation activities\/39:Remediation activities and other waste management services\/3900:Remediation activities and other waste management services","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire."},{"is_reference":false,"flow":"NOx","category":"E:Water supply; sewerage, waste management and remediation activities\/39:Remediation activities and other waste management services\/3900:Remediation activities and other waste management services","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire."},{"is_reference":false,"flow":"PM 10","category":"E:Water supply; sewerage, waste management and remediation activities\/39:Remediation activities and other waste management services\/3900:Remediation activities and other waste management services","amount":5.343e-5,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire."},{"is_reference":false,"flow":"CO2","category":"E:Water supply; sewerage, waste management and remediation activities\/39:Remediation activities and other waste management services\/3900:Remediation activities and other waste management services","amount":0.0534,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire (flujo de inventario directo, no el resultado de PCG)."},{"is_reference":false,"flow":"Bolsas de papel","category":"E:Water supply; sewerage, waste management and remediation activities\/38:Waste collection, treatment and disposal activities; materials recovery\/3811:Collection of non-hazardous waste","amount":0.0007,"unit":"Bolsas","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Residuo s\u00f3lido (probablemente de los sacos de cemento)."}]}
