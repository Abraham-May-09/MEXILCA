st\u00f3leo","category":"C:Manufacturing\/324:Petroleum and coal products manufacturing\/3241:Petroleum and coal products manufacturing\/32411:Petroleum refineries","amount":3230,"unit":"kJ","uncertainty":null,"provider":null,"description":"Energ\u00eda t\u00e9rmica."},{"is_reference":false,"flow":"Gas natural","category":"B:Mining, quarrying, and oil and gas extraction\/21:Mining and quarrying\/211:Oil and gas extraction","amount":422,"unit":"kJ","uncertainty":null,"provider":null,"description":"Energ\u00eda t\u00e9rmica."},{"is_reference":false,"flow":"Transporte de materia prima","category":"F:Transportation and warehousing\/48-49:Transportation and warehousing\/484:Truck transportation","amount":0.0173,"unit":"Tkm","uncertainty":null,"provider":null,"description":"Servicio de transporte para materias primas."}],"Outputs":[{"is_reference":true,"flow":"Cemento Portland","category":"C:Manufacturing\/327:Nonmetallic mineral product manufacturing\/3273:Cement and concrete product manufacturing\/32731:Cement manufacturing","amount":1,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Unidad funcional: 1 kg de cemento gris est\u00e1ndar terminado en planta."},{"is_reference":false,"flow":"CO2","category":"C:Manufacturing\/327:Nonmetallic mineral product manufacturing\/3273:Cement and concrete product manufacturing\/32731:Cement manufacturing","amount":0.8329,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisi\u00f3n al aire."},{"is_reference":false,"flow":"SO2","category":"C:Manufacturing\/327:Nonmetallic mineral product manufacturing\/3273:Cement and concrete product manufacturing\/32731:Cement manufacturing","amount":0.0005,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisi\u00f3n al aire."},{"is_reference":false,"flow":"NOx","category":"C:Manufacturing\/327:Nonmetallic mineral product manufacturing\/3273:Cement and concrete product manufacturing\/32731:Cement manufactur