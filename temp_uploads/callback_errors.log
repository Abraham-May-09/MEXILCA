\/3241:Petroleum and Coal Products Manufacturing\/32411:Petroleum Refineries","amount":36.2606,"unit":"kJ","uncertainty":null,"provider":null,"description":"Balance de energ\u00eda"},{"is_reference":false,"flow":"Autotransporte","category":"F:Transportation and warehousing\/48:Transportation\/484:Truck Transportation","amount":0.4772,"unit":"Tkm","uncertainty":null,"provider":"Chargoy, 2009","description":"Transporte de materia prima"}],"Outputs":[{"is_reference":true,"flow":"Block","category":"C:Manufacturing\/327:Nonmetallic Mineral Product Manufacturing\/3273:Cement and Concrete Product Manufacturing\/32733:Concrete Block and Brick Manufacturing","amount":1,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Unidad funcional: 1 kg de block terminado en planta."},{"is_reference":false,"flow":"Part\u00edculas sedimentables","category":"C:Manufacturing\/32733:Concrete Block and Brick Manufacturing","amount":9.328e-5,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"SO2","category":"C:Manufacturing\/32733:Concrete Block and Brick Manufacturing","amount":3.291e-5,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"CO","category":"C:Manufacturing\/32733:Concrete Block and Brick Manufacturing","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"NOx","category":"C:Manufacturing\/32733:Concrete Block and Brick Manufacturing","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"PM 10","category":"C:Manufacturing\/32733:Concrete Block and Brick Manufacturing","amount":5.343e-5,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"CO2","category":"C:Manufacturing\/32733:Concrete Block and Brick Manufacturing","amount":0.0534,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"Bolsas de papel","category":"C:Manufacturing\/322:Paper Manufacturing\/3222:Converted Paper Product Manufacturing","amount":0.0007,"unit":"Bolsas","uncertainty":null,"is_avoided":null,"provider":null,"description":"Residuos s\u00f3lidos"}]}
