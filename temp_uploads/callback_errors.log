ption":"Balance de materia"},{"is_reference":false,"flow":"Explosivos para extracci\u00f3n","category":"Fabricaci\u00f3n\/325\/Fabricaci\u00f3n de productos qu\u00edmicos\/32592\/Fabricaci\u00f3n de explosivos","amount":3.36e-5,"unit":"kg","uncertainty":null,"provider":null,"description":"Balance de materia"},{"is_reference":false,"flow":"Consumo el\u00e9ctrico","category":"Servicios p\u00fablicos\/221\/Servicios p\u00fablicos\/2211\/Generaci\u00f3n, transmisi\u00f3n y distribuci\u00f3n de energ\u00eda el\u00e9ctrica","amount":461,"unit":"kJ","uncertainty":null,"provider":null,"description":"Balance de energ\u00eda"},{"is_reference":false,"flow":"Diesel","category":"Fabricaci\u00f3n\/314\/Refinaci\u00f3n de petr\u00f3leo y carb\u00f3n\/31401\/Refinaci\u00f3n de petr\u00f3leo","amount":16,"unit":"kJ","uncertainty":null,"provider":null,"description":"Balance de energ\u00eda"},{"is_reference":false,"flow":"Combust\u00f3leo","category":"Fabricaci\u00f3n\/314\/Refinaci\u00f3n de petr\u00f3leo y carb\u00f3n\/31401\/Refinaci\u00f3n de petr\u00f3leo","amount":3230,"unit":"kJ","uncertainty":null,"provider":null,"description":"Balance de energ\u00eda"},{"is_reference":false,"flow":"Gas natural","category":"Servicios p\u00fablicos\/221\/Servicios p\u00fablicos\/2212\/Distribuci\u00f3n de gas natural","amount":422,"unit":"kJ","uncertainty":null,"provider":null,"description":"Balance de energ\u00eda"},{"is_reference":false,"flow":"Transporte de materia prima","category":"Transporte y almacenamiento\/484\/Transporte de carga por carretera","amount":0.0173,"unit":"t*km","uncertainty":null,"provider":null,"description":"Transporte de materia prima"}],"Outputs":[{"is_reference":true,"flow":"Cemento Portland","category":"Fabricaci\u00f3n\/327\/Fabricaci\u00f3n de productos minerales no met\u00e1licos\/32731\/Fabricaci\u00f3n de cemento","amount":1,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Unidad funcional: 1 kg de cemento gris est\u00e1ndar terminado en planta."},{"is_reference":false,"flow":"Di\u00f3xido de carbono","category":"Elementary flows\/Emissions to air","amount":0.8329,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"Di\u00f3xido de azufre","category":"Elementary flows\/Emissions to air","amount":0.0005,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"\u00d3xidos de nitr\u00f3geno","category":"Elementary flows\/Emissions to air","amount":0.002,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"Mon\u00f3xido de carbono","category":"Elementary flows\/Emissions to air","amount":0.0017,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"Carbono Org\u00e1nico Total (COT)","category":"Elementary flows\/Emissions to air","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"Compuestos Org\u00e1nicos Vol\u00e1tiles (COV)","category":"Elementary flows\/Emissions to air","amount":4.89e-7,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"},{"is_reference":false,"flow":"Metano","category":"Elementary flows\/Emissions to air","amount":3.59e-6,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Emisiones al aire"}]}
