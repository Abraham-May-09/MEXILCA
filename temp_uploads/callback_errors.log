xcept Oil and Gas)\/2123 Nonmetallic Mineral Mining and Quarrying","amount":4.4e-6,"unit":"kg","uncertainty":null,"provider":"Ecoinvent 3.4","description":"S\u00edlice para transformador y generador (original y reemplazo)."},{"is_reference":false,"flow":"Pl\u00e1stico","category":"Manufacturing\/326 Plastics and Rubber Products Manufacturing","amount":3.62e-6,"unit":"kg","uncertainty":null,"provider":"Ecoinvent 3.4","description":"Pl\u00e1stico para cable submarino."},{"is_reference":false,"flow":"Plomo","category":"Manufacturing\/331 Primary Metal Manufacturing\/3314 Nonferrous Metal (except Aluminum) Production and Processing","amount":3.15e-5,"unit":"kg","uncertainty":null,"provider":"Ecoinvent 3.4","description":"Plomo para cable submarino."},{"is_reference":false,"flow":"Concreto","category":"Manufacturing\/327 Nonmetallic Mineral Product Manufacturing\/3273 Cement and Concrete Product Manufacturing","amount":7.13e-6,"unit":"m3","uncertainty":null,"provider":"Ecoinvent 3.4","description":"Concreto para cimentaci\u00f3n."},{"is_reference":false,"flow":"Combust\u00f3leo pesado","category":"Manufacturing\/324 Petroleum and Coal Products Manufacturing","amount":0.000446,"unit":"kg","uncertainty":null,"provider":"Ecoinvent 3.4","description":"Combustible para maquinaria de instalaci\u00f3n."},{"is_reference":false,"flow":"Diesel","category":"Manufacturing\/324 Petroleum and Coal Products Manufacturing","amount":0.000228,"unit":"kg","uncertainty":null,"provider":"Ecoinvent 3.4","description":"Combustible para maquinaria de instalaci\u00f3n."},{"is_reference":false,"flow":"Aceite lubricante","category":"Manufacturing\/324 Petroleum and Coal Products Manufacturing","amount":0.00369,"unit":"kg","uncertainty":null,"provider":"Ecoinvent 3.4","description":"Lubricante para mantenimiento de la turbina."},{"is_reference":false,"flow":"Transporte, cami\u00f3n","category":"Transportation and Warehousing\/484 Truck Transportation","amount":0.00041,"unit":"tkm","uncertainty":nul