 Remediation Services\/5622 Waste Treatment and Disposal\/562212 Solid Waste Landfill","amount":2.04636e-5,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Residuos de FRP (fibra de vidrio) al final de la vida \u00fatil."},{"is_reference":false,"flow":"Foam Scrap, for recovery","category":"Wholesale Trade\/423 Merchant Wholesalers, Durable Goods\/4239 Miscellaneous Durable Goods Merchant Wholesalers\/423930 Recyclable Material Merchant Wholesalers","amount":3.9442e-5,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Residuos de espuma sint\u00e9tica para reciclaje."},{"is_reference":false,"flow":"ammonia, liquid, allocatable product","category":"Manufacturing\/325 Chemical Manufacturing\/3253 Fertilizer and Pesticide Manufacturing\/325311 Nitrogenous Fertilizer Manufacturing","amount":0.097512,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Re\u00faso de amoniaco al final de la vida \u00fatil."},{"is_reference":false,"flow":"Nylon 6.6, for recovery","category":"Wholesale Trade\/423 Merchant Wholesalers, Durable Goods\/4239 Miscellaneous Durable Goods Merchant Wholesalers\/423930 Recyclable Material Merchant Wholesalers","amount":0.0201,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Nylon para reciclaje al final de la vida \u00fatil."},{"is_reference":false,"flow":"Copper scrap, for recovery","category":"Wholesale Trade\/423 Merchant Wholesalers, Durable Goods\/4239 Miscellaneous Durable Goods Merchant Wholesalers\/423930 Recyclable Material Merchant Wholesalers","amount":5.04243e-7,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":"Cobre para reciclaje al final de la vida \u00fatil."}]}
