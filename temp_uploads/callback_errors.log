manufactureras\/324:Fabricaci\u00f3n de productos de coquer\u00eda y refinaci\u00f3n de petr\u00f3leo\/3241:Fabricaci\u00f3n de productos de coquer\u00eda y refinaci\u00f3n de petr\u00f3leo","amount":36.2606,"unit":"kJ","uncertainty":null,"provider":"Chargoy, 2009","description":"Consumo energ\u00e9tico en planta"},{"is_reference":false,"flow":"Autotransporte","category":"H:Transporte y almacenamiento\/49:Transporte terrestre y por tuber\u00eda\/492:Transporte de carga por carretera","amount":0.4772,"unit":"Tkm","uncertainty":null,"provider":"Chargoy, 2009","description":"Transporte de materia prima a la planta"}],"Outputs":[{"is_reference":true,"flow":"Block","category":"C:Industrias manufactureras\/327:Fabricaci\u00f3n de productos a base de minerales no met\u00e1licos\/3273:Fabricaci\u00f3n de cemento y productos de hormig\u00f3n\/32733:Fabricaci\u00f3n de tubos, ladrillos y bloques de hormig\u00f3n","amount":1,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":null,"description":"Unidad funcional: 1 kg de block terminado en planta"},{"is_reference":false,"flow":"Part\u00edculas sedimentables","category":"Emissions to air","amount":9.328e-5,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"SO2","category":"Emissions to air","amount":3.291e-5,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"CO","category":"Emissions to air","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"NOx","category":"Emissions to air","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"PM 10","category":"Emissions to air","amount":5.343e-5,"unit":"kg","uncertainty":null,"is_avoi