cers","description":"Fertilizante compuesto."},{"is_reference":false,"flow":"Sulfato Amonio","category":"Manufacturing\/325 Chemical Manufacturing\/325310 Fertilizer Manufacturing","amount":0.0021428,"unit":"kg","uncertainty":null,"provider":"Primary data from producers","description":"Fertilizante."},{"is_reference":false,"flow":"Sulfato de Calcio","category":"Manufacturing\/325 Chemical Manufacturing\/325310 Fertilizer Manufacturing","amount":0.0031428,"unit":"kg","uncertainty":null,"provider":"Primary data from producers","description":"Fertilizante."},{"is_reference":false,"flow":"Sulfato de Potasio","category":"Manufacturing\/325 Chemical Manufacturing\/325310 Fertilizer Manufacturing","amount":0.002602,"unit":"kg","uncertainty":null,"provider":"Primary data from producers","description":"Fertilizante."},{"is_reference":false,"flow":"Superfosfato Triple Grado","category":"Manufacturing\/325 Chemical Manufacturing\/325310 Fertilizer Manufacturing","amount":0.0021428,"unit":"kg","uncertainty":null,"provider":"Primary data from producers","description":"Fertilizante."},{"is_reference":false,"flow":"Technigro 20-10-20","category":"Manufacturing\/325 Chemical Manufacturing\/325310 Fertilizer Manufacturing","amount":0.0022357,"unit":"kg","uncertainty":null,"provider":"Primary data from producers","description":"Fertilizante compuesto."},{"is_reference":false,"flow":"Urea","category":"Manufacturing\/325 Chemical Manufacturing\/325310 Fertilizer Manufacturing","amount":0.0025,"unit":"kg","uncertainty":null,"provider":"Primary data from producers","description":"Fertilizante."}],"Outputs":[{"is_reference":true,"flow":"Pi\u00f1a fresca","category":"Agriculture, Forestry, Fishing and Hunting\/111 Crop Production\/111219 Other Noncitrus Fruit Farming","amount":1,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":null,"description":"Producto de referencia (unidad funcional). Pi\u00f1a fresca cosechada bajo el sistema de producci\u00f3n convencional."}]}
