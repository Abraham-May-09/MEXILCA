[2025-11-23 20:52:41] Datos recibidos: {"General information":{"UUID":"dd5ba4b5-208d-42f0-9fc2-bd74273693e2","Name":"market for carbon monoxide - US - carbon monoxide","Category":"Manufactura\/3251 Fabricaci\u00f3n de productos qu\u00edmicos b\u00e1sicos","Description":"Esta es una actividad de mercado que representa la mezcla de consumo de mon\u00f3xido de carbono en Estados Unidos. El mercado conecta proveedores con consumidores del mismo producto en la misma \u00e1rea geogr\u00e1fica. Agrupa a los productores y tambi\u00e9n las importaciones del producto (si son relevantes) dentro de la misma \u00e1rea geogr\u00e1fica. Tambi\u00e9n contabiliza el transporte al consumidor y las p\u00e9rdidas durante ese proceso, cuando es relevante. Este producto generalmente se considera un producto intermedio y, como tal, se espera que se utilice en o en las inmediaciones del sitio de producci\u00f3n. El mon\u00f3xido de carbono es una sustancia inorg\u00e1nica con f\u00f3rmula molecular CO, que es un gas en condiciones normales de temperatura y presi\u00f3n. En el nivel del consumidor, se utiliza en los siguientes productos: productos qu\u00edmicos de laboratorio, combustibles, productos para el tratamiento de superficies met\u00e1licas, pol\u00edmeros y semiconductores.","Tags":"mercado, mon\u00f3xido de carbono, productos qu\u00edmicos b\u00e1sicos, sustancias inorg\u00e1nicas, gases industriales","Technology | Description":"Actividad de mercado que representa el consumo mix de mon\u00f3xido de carbono en Estados Unidos. Incluye la conexi\u00f3n entre proveedores y consumidores, agrupaci\u00f3n de productores e importaciones, y contabilizaci\u00f3n de transporte y p\u00e9rdidas cuando son relevantes. El producto se modela como una sustancia pura.","Code":"US","Last_change":"23\/11\/2025 20:51"},"location":{"@type":"Location","@id":"0b3b97fa-6688-3c56-88ee-4ae80ec0c3c2","name":"United States","description":"reference location, sources: ISO 3166-1, ecoinvent 3, ILCD, GaBi","version":"00.00.000","code":"US","latitude":39.622,"longitude":-98.606},"processDocumentation":{"LCI method":"Allocation, cut-off system model","Process type":"Market activity","Modeling constants":"Product is generally considered to be used at or in the vicinity of the production site; no transport requirements included","Data source information":"ecoinvent 3.11 database","Data completeness":"Covers all relevant flows for carbon monoxide market in United States geography","Data selection":"Includes suppliers and imports within the same geographical area; accounts for transport to consumer and losses when relevant","Data treatment":"Market represents consumption mix connecting suppliers with consumers","Sampling procedure":"Not specified","Data collection period":"2011-01-01 to 2024-12-31","Use advice":"Valid for direct consumption; product is generally considered an intermediate product used at or near production site","Completeness":"Complete for market representation of carbon monoxide in US geography","Sources":"ecoinvent Association","Project":"Not specified","Intended application":"Life cycle assessment studies","Data set owner":"ecoinvent Association","Data set generator":"lasonas loannou","Data set documentor":"lasonas loannou","Publication":"ecoinvent 3.11 database documentation","Creation date":"2025","Copyright":"Copyright ecoinvent Association, 2025","Access and use restrictions":"Restrictions of use stipulated in the EULA remain applicable"},"actors":{"@id":"47a88430-1dd2-4569-9741-8249a6672ae2","name":"IINGEN-UNAM","description":"Instituto de Ingenier\u00eda de la UNAM","category":"Organizaciones de investigaci\u00f3n","version":"01.00.000","lastChange":"2025-11-23T20:52:02.534Z","address":"Circuito Escolar s\/n, Ciudad Universitaria","city":"Coyoac\u00e1n","zipCode":"04510","country":"MX","email":"APadillaR@iingen.unam.mx","telephone":"+52 5556233600","telefax":null,"website":"http:\/\/www.iingen.unam.mx"},"Inputs":[{"is_reference":false,"flow":"carbon monoxide","category":"","amount":0.5,"unit":"kg","uncertainty":"","provider":"carbon monoxide production, from synthesis gas, through absorption US - carbon monoxide","description":""},{"is_reference":false,"flow":"carbon monoxide","category":"","amount":0.5,"unit":"kg","uncertainty":"","provider":"carbon monoxide production, from synthesis gas, through cryogenic separation US - carbon monoxide","description":""}],"Outputs":[{"is_reference":true,"flow":"carbon monoxide","category":"","amount":1,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":null,"description":null}]}
