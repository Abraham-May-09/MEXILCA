9","description":null}],"Outputs":[{"is_reference":true,"flow":"vigueta","category":"C:Manufacturing\/23:Manufacture of other non-metallic mineral products\/236:Manufacture of articles of concrete, cement and plaster","amount":1,"unit":"m lineal de vigueta","uncertainty":null,"is_avoided":null,"provider":null,"description":"Producto de referencia, vigueta de alma abierta."},{"is_reference":false,"flow":"Part\u00edculas sedimentables","category":"Emissions to air","amount":0.0015,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"SO2","category":"Emissions to air","amount":0.0012,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"CO","category":"Emissions to air","amount":0.0041,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"NOx","category":"Emissions to air","amount":0.0048,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"PM-10","category":"Emissions to air","amount":0.0009,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"},{"is_reference":false,"flow":"CO2","category":"Emissions to air","amount":2.0172,"unit":"kg","uncertainty":null,"is_avoided":null,"provider":"Chargoy, 2009","description":"Emisi\u00f3n al aire"}]}
