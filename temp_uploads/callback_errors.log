nty":null,"provider":"Chargoy, 2009, y Espinoza, 2005","description":"Transporte agregado de todas las materias primas."}],"Outputs":[{"is_reference":true,"flow":"Cemento Portland","category":"C:Manufacturing\/327:Nonmetallic Mineral Product Manufacturing\/3273:Cement and Concrete Product Manufacturing\/327310:Cement Manufacturing","amount":1,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":null,"description":"Unidad funcional: 1 kg de cemento gris est\u00e1ndar terminado en planta."},{"is_reference":false,"flow":"CO2","category":"Emisiones al aire","amount":0.8329,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009, y Espinoza, 2005","description":"Di\u00f3xido de carbono"},{"is_reference":false,"flow":"SO2","category":"Emisiones al aire","amount":0.0005,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009, y Espinoza, 2005","description":"Di\u00f3xido de azufre"},{"is_reference":false,"flow":"NOx","category":"Emisiones al aire","amount":0.002,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009, y Espinoza, 2005","description":"\u00d3xidos de nitr\u00f3geno"},{"is_reference":false,"flow":"CO","category":"Emisiones al aire","amount":0.0017,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009, y Espinoza, 2005","description":"Mon\u00f3xido de carbono"},{"is_reference":false,"flow":"COT","category":"Emisiones al aire","amount":0.0001,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009, y Espinoza, 2005","description":"Carbono Org\u00e1nico Total"},{"is_reference":false,"flow":"COV","category":"Emisiones al aire","amount":4.89e-7,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009, y Espinoza, 2005","description":"Compuestos Org\u00e1nicos Vol\u00e1tiles"},{"is_reference":false,"flow":"CH4","category":"Emisiones al aire","amount":3.59e-6,"unit":"kg","uncertainty":null,"is_avoided":false,"provider":"Chargoy, 2009, y Es