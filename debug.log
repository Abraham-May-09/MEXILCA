(
    [action] => save_process
    [uuid] => 4a1472f1-b070-46f2-9ade-38c8d163b603
    [process_name] => ACV VIGUETA: ANÁLISIS DE CICLO DE VIDA DEL VIGUETA
    [category] => Manufactura/327 Fabricación de Productos de Minerales No Metálicos
    [general_comment] => Se determinó la huella de carbono y la demanda acumulada de energía durante la fabricación de vigueta, a partir de un Inventario de Ciclo de Vida (ICV) con datos obtenidos en México, y tomando como base las especificaciones de la ISO 14044. El objetivo es estimar la huella de carbono durante el proceso de fabricación de viguetas en plantas localizadas en la zona centro de México. El alcance se limita al estudio del proceso de fabricación de vigueta en plantas localizadas en México (extracción de materia prima, transporte y fabricación). La unidad funcional es producir un metro lineal de vigueta terminada en planta en la zona centro de México, con datos de 2009. El resultado obtenido respecto a la producción de 1 m lineal de vigueta en planta fue de 6.40565 kgCO2eq.
    [technology_description] => 
    [geo_description] => 
    [process_type] => 
    [time_desc] => 
    [version] => 01.00.000
    [valid_from] => 
    [valid_until] => 
    [project] => Generación de inventarios para el Análisis de Ciclo de Vida de cemento, block, bovedilla, vigueta y ladrillo en la zona centro de México.
    [lci_method] => ISO 14044, CML 2001 v. 4.2
    [ds_data_selection] => Criterio de corte de masa al 1%; cualquier compuesto que represente menos del 1% de la masa total no se tomará en cuenta.
    [ds_data_treatment] => El consumo de electricidad y de gas LP se dividió entre la producción correspondiente para obtener un aproximado real de consumo por pieza producida. Los resultados de las diferentes empresas se promediaron de forma ponderada con base en el nivel de producción.
    [data_collection_period] => 2009
    [ds_data_completeness] => Se omite el consumo por soldadura (0.356% de la masa de la vigueta húmeda). No se obtuvieron datos suficientes para determinar la emisión de sólidos totales al agua. Para la extracción de materia prima únicamente se incluye el impacto por el transporte, debido a la negativa de las empresas extractoras para aportar mayor información.
    [completeness_text] => Parcial. El inventario omite el consumo de soldadura, las emisiones al agua, y los procesos de extracción de materias primas (excepto su transporte).
    [sources_text] => Array
    [modeling_constants] => Criterio de corte de masa al 1%. Supuestos: mix energético nacional de México (CMM 2014), factores de emisión AP-42 adaptados a México, agua de la red, distancias de transporte estimadas con INEGI DENUE.
    [access_restrictions] => 
    [copyright] => 0
    [modeller_uuid] => 
    [owner_uuid] => 
)

